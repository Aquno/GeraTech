# Valores fictícios para desenvolvimento local. Copie para .env e ajuste.
DATABASE_URL=postgresql://orders_user:orders_pass@localhost:5432/orders_dev
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Opcionais. Todas já têm esses mesmos valores como padrão no docker-compose.yml,
# nos testes ou no Vite. Descomente só o que quiser mudar.
# ATENÇÃO: são valores fictícios, apenas para ambiente local de desenvolvimento.
# Nunca use estas credenciais fora da sua máquina.
# ---------------------------------------------------------------------------

# Banco do docker-compose (serviço db) e porta publicada no host.
# POSTGRES_USER=orders_user
# POSTGRES_PASSWORD=orders_pass
# POSTGRES_DB=orders_dev
# POSTGRES_PORT=5432

# Porta da interface web (nginx) no host.
# WEB_PORT=8080

# Banco dos testes de integração (precisa terminar em _test).
# TEST_DATABASE_URL=postgresql://orders_user:orders_pass@localhost:5432/orders_test

# API usada pelo servidor de desenvolvimento do frontend (npm run dev em web/).
# API_URL=http://localhost:3000

# Usuário do container do k6 (Linux com uid diferente de 1000: use $(id -u) e $(id -g)).
# K6_UID=1000
# K6_GID=1000
