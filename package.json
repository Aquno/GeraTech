{
  "name": "orders-api",
  "version": "0.1.0",
  "private": true,
  "description": "API de pedidos sobre um cardápio fixo (Fastify + PostgreSQL).",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx src/infra/db/migrate.ts",
    "seed": "tsx src/infra/db/seed.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
