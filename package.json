{
  "name": "orders-api",
  "version": "0.1.0",
  "private": true,
  "description": "API de pedidos sobre um cardápio fixo (Fastify + PostgreSQL).",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
